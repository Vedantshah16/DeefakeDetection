# ========================================
# Pinnacle 6 Backend — Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git
# ========================================

# REQUIRED for production: Secret key for JWT token signing
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If not set, a random key is generated at startup (tokens invalidate on restart)
SECRET_KEY=

# JWT token expiry in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS origins (comma-separated)
# Default: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File upload size limits (in MB)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=50

# Optional: Reality Defender API Key
# Sign up at https://realitydefender.com to get a key
# Leave blank to use local models only
REALITY_DEFENDER_API_KEY=

# Optional: Audio Deepfake Detection API Key
# Leave blank to use simulation mode for audio
AUDIO_DEEPFAKE_API_KEY=

# Optional: Path to trained XceptionNet model file
# Default: deepfake_xception.h5 (in backend directory)
MODEL_PATH=deepfake_xception.h5
