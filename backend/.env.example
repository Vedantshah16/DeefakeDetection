# ========================================
# Pinnacle 6 Backend — Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git
# ========================================

# Optional: Reality Defender API Key
# Sign up at https://realitydefender.com to get a key
# Leave blank to use local models only
REALITY_DEFENDER_API_KEY=

# Optional: Audio Deepfake Detection API Key
# Leave blank to use simulation mode for audio
AUDIO_DEEPFAKE_API_KEY=

# Optional: Path to trained XceptionNet model file
# Default: deepfake_xception.h5 (in backend directory)
MODEL_PATH=deepfake_xception.h5
