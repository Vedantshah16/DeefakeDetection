# ========================================
# Pinnacle 6 — .gitignore
# ========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/

# Environment / Secrets — NEVER UPLOAD
.env
.env.local
.env.production
.env.bak
*.env
secrets.json
config_secret.py
backend/firebase-service-account.json

# Model Weights (large binary files — tracked via Git LFS, not ignored)
*.h5
*.pkl
*.onnx
*.pt
*.weights
*.pb
*.tflite

# Database files (contain user data)
*.db
*.sqlite
*.sqlite3
backend/*.db-journal

# Node / Frontend
node_modules/
dist/
build/
.next/
npm-debug.log*
frontend/.vite/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test outputs
*_output.txt
diagnostic_output.txt
diagnostic_results.txt
startup_log*.txt

# Jupyter
.ipynb_checkpoints/

# Test cache
.pytest_cache/

# Temp files
*.tmp
*.bak

# Backup folder
BACKUP_SOURCE/
