# ══════════════════════════════════════════════════════════════
#  TrueSight AI — Production Environment Config
#  Copy this to prod.env and fill in all values.
#  NEVER commit prod.env to git.
# ══════════════════════════════════════════════════════════════

# ── Azure Infra ──────────────────────────────────────────────
APP_NAME=truesight
# ACR name must be globally unique, lowercase, 5-50 chars, no hyphens
ACR_NAME=truesightacr
RESOURCE_GROUP=truesight-rg
LOCATION=centralindia

# ── Backend secrets ──────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-strong-random-string

# Firebase service account JSON encoded as base64:
#   base64 -i backend/firebase-service-account.json | tr -d '\n'
# (Leave empty if you don't use Google/Phone auth)
FIREBASE_SA_BASE64=

# ── Frontend build config ────────────────────────────────────
# Leave empty on first run — filled automatically after backend deploys
# On subsequent runs, set this to the backend FQDN
VITE_API_URL=
